pipeline {
    agent any

    tools {
        maven 'Default'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/ugileeknathn/selenium-automation.git'
            }
        }

        stage('Build') {
            steps {
                dir('selenium-automation') {
                    bat 'mvn clean install'
                }
            }
        }

		stage('Publish TestNG Report') {
    		steps {
        		 publishHTML([
           		 reportDir: 'selenium-automation/test-output',
           		 reportFiles: 'index.html',
           		 reportName: 'TestNG Detailed Report'])
   			 }
		}

        // New stage to verify file path
        stage('Verify Resume File') {
            steps {
                dir('selenium-automation') {
                    // Print the resolved path
                    bat 'echo Resume path: %cd%\\src\\test\\resources\\Eknath_Ugile_Resume.pdf'
                    // List files in resources folder
                    bat 'dir src\\test\\resources'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('selenium-automation') {
                    bat 'mvn test'
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                junit 'selenium-automation/target/surefire-reports/*.xml'
            }
        }
    }

    post {
        success {
            echo ' Build and tests completed successfully!'
        }
        failure {
            echo ' Build failed. Check console output for details.'
        }
    }
}
